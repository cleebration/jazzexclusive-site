{
  // Cloudflare Worker mit statischen Assets — Aufbau wie babowalls.com / lko-site.
  "name": "jazzexclusive-site",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.js",

  // workers.dev-Adresse: Vorschau, solange die Domain noch auf Wix zeigt.
  "workers_dev": true,
  "preview_urls": true,

  // Cloudflare legt die DNS-Einträge beim Deploy selbst an; die Wix-Einträge
  // (A @ ×3, CNAME www) müssen vorher weg. m. war auf Wix nicht eingetragen.
  // Schritt 2 (07.10.2026): eigene Namen aktiv. Vorher müssen bei Cloudflare
  // die Wix-Einträge weg sein (A @ ×3, CNAME www), sonst bricht der Deploy ab.
  "routes": [
    { "pattern": "jazzexclusive.at",     "custom_domain": true },
    { "pattern": "www.jazzexclusive.at", "custom_domain": true }
  ],

  // Newsletter-Secrets NICHT hier, sondern einmalig per
  //   npx wrangler secret put EMAILOCTOPUS_API_KEY
  //   npx wrangler secret put EMAILOCTOPUS_LIST_ID
  "vars": {
    "EMAILOCTOPUS_TAGS": "jazzexclusive",
    "EMAILOCTOPUS_API_VERSION": "v2"
  },

  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },

  "observability": { "enabled": true }
}
